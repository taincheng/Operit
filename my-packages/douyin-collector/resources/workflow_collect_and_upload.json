{
  "id": "douyin-collect-and-upload-seed",
  "name": "抖音采集与上报",
  "description": "每 15 分钟采一片抖音分享链接，并把 outbox 里的待上报记录发给服务端。带手动触发节点，方便随时试跑。导入后可按需修改关键词与间隔。",
  "nodes": [
    {
      "__type": "com.ai.assistance.operit.data.model.TriggerNode",
      "id": "trigger_schedule_douyin",
      "type": "trigger",
      "name": "每 15 分钟定时触发",
      "description": "定时器只负责点火，分片与续跑逻辑都在采集脚本内",
      "position": {
        "x": 120.0,
        "y": 120.0
      },
      "triggerType": "schedule",
      "triggerConfig": {
        "schedule_type": "interval",
        "interval_ms": "900000",
        "enabled": "true",
        "repeat": "true"
      }
    },
    {
      "__type": "com.ai.assistance.operit.data.model.TriggerNode",
      "id": "trigger_manual_douyin",
      "type": "trigger",
      "name": "手动触发",
      "description": "在编辑器里点「触发工作流」时走这个节点，方便随时试跑一次",
      "position": {
        "x": 120.0,
        "y": 460.0
      },
      "triggerType": "manual",
      "triggerConfig": {}
    },
    {
      "__type": "com.ai.assistance.operit.data.model.ExecuteNode",
      "id": "execute_collect_chunk",
      "type": "execute",
      "name": "采一片分享链接",
      "description": "采到条数目标或时间上限就结束本片，进度写进 progress.json，下一片接着跑不会重采",
      "position": {
        "x": 820.0,
        "y": 290.0
      },
      "actionType": "douyin_collector:douyin_collect_share_links",
      "actionConfig": {
        "keyword": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.StaticValue",
          "value": "美食"
        },
        "count": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.StaticValue",
          "value": "6"
        },
        "chunk_minutes": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.StaticValue",
          "value": "18"
        }
      },
      "jsCode": null
    },
    {
      "__type": "com.ai.assistance.operit.data.model.ExecuteNode",
      "id": "execute_flush_outbox",
      "type": "execute",
      "name": "上报待发送记录",
      "description": "把 outbox 里 pending 的记录按每批 20 条发给服务端，需要先在该插件配置目录放好 config.json",
      "position": {
        "x": 1520.0,
        "y": 290.0
      },
      "actionType": "douyin_collector:douyin_outbox_flush",
      "actionConfig": {},
      "jsCode": null
    }
  ],
  "connections": [
    {
      "id": "conn_douyin_schedule_to_collect",
      "sourceNodeId": "trigger_schedule_douyin",
      "targetNodeId": "execute_collect_chunk",
      "condition": null
    },
    {
      "id": "conn_douyin_manual_to_collect",
      "sourceNodeId": "trigger_manual_douyin",
      "targetNodeId": "execute_collect_chunk",
      "condition": null
    },
    {
      "id": "conn_douyin_collect_to_flush",
      "sourceNodeId": "execute_collect_chunk",
      "targetNodeId": "execute_flush_outbox",
      "condition": null
    }
  ],
